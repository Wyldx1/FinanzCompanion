# Domain (Produktion, Hetzner) — Caddy holt das TLS-Zertifikat dafür
DOMAIN=finanzen.deine-domain.de

# Datenbank
DB_PASSWORD=change-me-to-a-long-random-string
DATABASE_URL=postgres://finanzen:password@localhost:5432/finanzen

# App
APP_URL=http://localhost:3000
SESSION_SECRET=your-session-secret-here-at-least-32-chars
AUTH_PASSPHRASE_HASH=

# Telegram (optional für MVP)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: bekannte Chat-ID direkt erlauben. Alternativ Paarung über
# /settings/telegram in der Web-App (Einmal-Code + /start <code> im Bot).
TELEGRAM_ALLOWED_CHAT_ID=

# Claude API
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-4-20250514
PARSER_MODEL=claude-haiku-4-5-20251001
COACH_TONE=direkt

# Zeitplan
TZ=Europe/Berlin
REMINDER_DAY_1=28
REMINDER_HOUR=19
