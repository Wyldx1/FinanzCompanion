{
  "name": "finanz-companion",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @finanz/db build && pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @finanz/web dev",
    "dev:bot": "pnpm --filter @finanz/bot dev",
    "dev:worker": "pnpm --filter @finanz/worker dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @finanz/db generate",
    "db:migrate": "pnpm --filter @finanz/db migrate",
    "db:seed": "pnpm --filter @finanz/db seed",
    "db:studio": "pnpm --filter @finanz/db studio",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.7.0"
}
